generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
    directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Land {
    id         String   @id @default(cuid())
    name       String
    land_size  Int
    land_price Int
    endowment  Boolean  @default(false)
    image      String?
    created_by String
    updated_by String
    created_at DateTime @default(now())
    updated_At DateTime
}

enum RealEstateType {
    LAND
    APARTMENT
    VILLA
    BUILDING
    // Add more types as needed
}

enum PaymentMethodType {
    CASH
    INSTALLMENT
    BOTH
}

enum OverlookingType {
    MAINSTREET
    SUBSTREET
    SEA
    BACK
}

enum RentOrSell {
    RENT
    SELL
    BOTH
}

enum Status {
    UNDER_REVIEW
    SOLD
    APPROVED
}

// Define the RealEstate table
model RealEstate {
    id             String            @id @default(cuid())
    type           RealEstateType
    title          String
    description    String
    details        Json // Store details as JSON
    payment_method PaymentMethodType
    rentOrSell     RentOrSell
    price          Float
    size           Float
    overlooking    OverlookingType
    status         Status
    created_by     String
    updated_by     String
    created_at     DateTime          @default(now())
    updated_At     DateTime
}
