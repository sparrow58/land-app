    "@types/bcrypt": "^5.0.1",
    "@types/negotiator": "^0.6.1",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@vercel/analytics": "^1.0.2",
    "@vercel/blob": "^0.12.2",
    "aos": "^3.0.0-beta.6",
    "autoprefixer": "10.4.15",
    "axios": "^1.5.0",
    "bcrypt": "^5.1.1",
    "compressorjs": "^1.2.1",
    "eslint": "8.48.0",
    "eslint-config-next": "^14.0.1",
