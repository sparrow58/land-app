{
  "name": "land-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "migrate:dev": "npx dotenv -e .env.development -- npx prisma migrate dev",
    "migrate:pro": "npx dotenv -e .env.production -- npx prisma migrate deploy",
    "studio:dev": "npx dotenv -e .env.development -- npx prisma studio",
    "studio:pro": "npx dotenv -e .env.production -- npx prisma studio"
  },
  "prisma": {
    "seed": "ts-node-esm --compiler-options {\"module\":\"CommonJS\"} prisma/seeds/userSeeds.ts"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.14",
    "@prisma/client": "^5.2.0",
    "@types/react": "18.2.21",
    "@types/react-dom": "18.2.7",
    "@vercel/blob": "^0.12.2",
    "autoprefixer": "10.4.15",
    "axios": "^1.5.0",
    "eslint": "8.48.0",
    "eslint-config-next": "13.4.19",
    "formik": "^2.4.3",
    "next": "13.4.19",
    "postcss": "8.4.28",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-toastify": "^9.1.3",
    "tailwindcss": "3.3.3",
    "yup": "^1.2.0",
    "aos": "^3.0.0-beta.6"
  },
  "devDependencies": {
    "@types/node": "^20.6.0",
    "@types/aos": "^3.0.4",
    "cross-env": "^7.0.3",
    "prisma": "^5.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}