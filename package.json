{
  "name": "land-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "migrate:dev": "npx dotenv -e .env.development -- npx prisma migrate dev",
    "migrate:pro": "npx dotenv -e .env.production -- npx prisma migrate deploy",
    "studio:dev": "npx dotenv -e .env.development -- npx prisma studio",
    "studio:pro": "npx dotenv -e .env.production -- npx prisma studio"
  },
  "prisma": {
    "seed": "ts-node-esm --compiler-options {\"module\":\"CommonJS\"} prisma/seeds/userSeeds.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^1.0.4",
